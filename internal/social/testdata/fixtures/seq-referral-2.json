          "now": 1700000010,
          "expect": "ok",
          "state_after": "Forwarded"
        },
        {
          "envelope": {"id": "00000000000000000000000000000000000000000000000000000000000011d9", "author": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", "created_at": 1700000020, "content": "{\"v\":1,\"type\":\"referral_accept\",\"forward\":\"00000000000000000000000000000000000000000000000000000000000011d8\"}"},
